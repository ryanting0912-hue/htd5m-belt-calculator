<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HTD-5M 時規皮帶與惰輪幾何計算器</title>
  <style>
    :root {
      --bg-dark: #181c24;
      --panel-bg: #222733;
      --card-bg: #2a303f;
      --border-color: #3a4256;
      --text-main: #eef2f7;
      --text-muted: #9aa5b8;
      --accent-blue: #3b82f6;
      --accent-pink: #f472b6;
      --accent-green: #10b981;
      --accent-amber: #f59e0b;
      --accent-red: #ef4444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Microsoft JhengHei", sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* Header & Mode Switcher */
    header {
      background-color: var(--panel-bg);
      border-bottom: 1px solid var(--border-color);
      padding: 10px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-badge {
      background: linear-gradient(135deg, #ec4899, #3b82f6);
      color: white;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }

    .brand h1 {
      font-size: 1.15rem;
      font-weight: 700;
    }

    .mode-tabs {
      display: flex;
      background-color: var(--bg-dark);
      padding: 4px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
    }

    .mode-tab {
      padding: 8px 16px;
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 0.9rem;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .mode-tab.active {
      background-color: var(--accent-blue);
      color: #fff;
      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.35);
    }

    /* Main Workspace Layout */
    .workspace {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    /* Left Sidebar Controls */
    .sidebar {
      width: 440px;
      min-width: 380px;
      background-color: var(--panel-bg);
      border-right: 1px solid var(--border-color);
      overflow-y: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 14px;
    }

    .card-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 8px;
    }

    .card-title span.tag {
      font-size: 0.75rem;
      background-color: rgba(59, 130, 246, 0.2);
      color: #60a5fa;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 600;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .input-group label {
      font-size: 0.78rem;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
    }

    .input-with-unit {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-with-unit input,
    .input-group select {
      width: 100%;
      background-color: var(--bg-dark);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 7px 34px 7px 10px;
      border-radius: 6px;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.15s;
    }

    .input-group select {
      padding-right: 10px;
      cursor: pointer;
    }

    .input-with-unit input:focus,
    .input-group select:focus {
      border-color: var(--accent-blue);
    }

    .input-with-unit .unit {
      position: absolute;
      right: 9px;
      font-size: 0.75rem;
      color: var(--text-muted);
      pointer-events: none;
    }

    .sub-info {
      font-size: 0.74rem;
      color: #93c5fd;
      margin-top: 2px;
    }

    /* Idler Item Block */
    .idler-box {
      background-color: rgba(0, 0, 0, 0.2);
      border: 1px solid var(--border-color);
      border-left: 3px solid var(--accent-amber);
      border-radius: 8px;
      padding: 10px;
      margin-top: 8px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .idler-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.84rem;
      font-weight: 700;
      color: #fcd34d;
    }

    .relative-readout {
      background-color: rgba(16, 185, 129, 0.08);
      border: 1px dashed rgba(16, 185, 129, 0.35);
      border-radius: 6px;
      padding: 8px;
      font-size: 0.78rem;
      line-height: 1.5;
      color: #d1fae5;
    }

    .btn-small {
      background-color: var(--border-color);
      color: #fff;
      border: none;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.74rem;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-small:hover {
      background-color: var(--accent-blue);
    }

    /* Toggle Switch */
    .toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.82rem;
      padding: 4px 0;
    }

    .toggle-row input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--accent-green);
      cursor: pointer;
    }

    /* Output Metrics Cards */
    .result-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .result-item {
      background-color: var(--bg-dark);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 10px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .result-item.highlight {
      border-color: var(--accent-green);
      background-color: rgba(16, 185, 129, 0.1);
    }

    .result-item .r-label {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .result-item .r-sub {
      font-size: 0.72rem;
      color: #9ca3af;
      margin-top: 2px;
    }

    .result-item .r-value {
      font-size: 1.1rem;
      font-weight: 800;
      color: #fff;
      text-align: right;
    }

    .result-item.highlight .r-value {
      color: #34d399;
    }

    /* Right Canvas Container */
    .canvas-area {
      flex: 1;
      position: relative;
      background-color: #2f3640;
      display: flex;
      flex-direction: column;
    }

    canvas {
      width: 100%;
      height: 100%;
      display: block;
      cursor: grab;
    }

    canvas:active {
      cursor: grabbing;
    }

    /* Canvas Floating Overlays */
    .canvas-toolbar {
      position: absolute;
      top: 14px;
      left: 14px;
      display: flex;
      gap: 8px;
      background: rgba(24, 28, 36, 0.85);
      backdrop-filter: blur(6px);
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      align-items: center;
      flex-wrap: wrap;
    }

    .status-pill {
      position: absolute;
      top: 14px;
      right: 14px;
      background: rgba(24, 28, 36, 0.9);
      backdrop-filter: blur(6px);
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      font-size: 0.82rem;
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 240px;
    }

    .legend-bar {
      position: absolute;
      bottom: 14px;
      left: 14px;
      right: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(24, 28, 36, 0.85);
      backdrop-filter: blur(6px);
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      font-size: 0.78rem;
      color: var(--text-muted);
      flex-wrap: wrap;
      gap: 10px;
    }

    .legend-items {
      display: flex;
      gap: 14px;
      align-items: center;
      flex-wrap: wrap;
    }

    .dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      margin-right: 5px;
    }

    @media (max-width: 960px) {
      body {
        overflow: auto;
        height: auto;
      }
      .workspace {
        flex-direction: column;
      }
      .sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 1px solid var(--border-color);
      }
      .canvas-area {
        height: 620px;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">
      <span class="brand-badge">HTD-5M</span>
      <h1>時規皮帶與惰輪幾何計算器 (CAD 視覺化互動版)</h1>
    </div>
    <div class="mode-tabs">
      <button class="mode-tab active" id="tabMode1" onclick="switchMode(1)">
        模式一：固定皮帶長度 ➔ 拖曳找惰輪位置
      </button>
      <button class="mode-tab" id="tabMode2" onclick="switchMode(2)">
        模式二：固定皮帶輪與惰輪 ➔ 計算皮帶長度
      </button>
    </div>
  </header>

  <div class="workspace">
    <!-- 左側控制面板 -->
    <aside class="sidebar">

      <!-- 1. 皮帶輪與距離基本參數 -->
      <div class="card">
        <div class="card-title">
          <span>1. 主皮帶輪與相對位置設定</span>
          <span class="tag">X右正左負 / Y上正下負</span>
        </div>
        <div class="grid-2">
          <div class="input-group">
            <label>皮帶輪(輸入) 齒數</label>
            <div class="input-with-unit">
              <input type="number" id="inTeeth" value="18" min="8" max="200" step="1" oninput="onParamChange()" />
              <span class="unit">齒</span>
            </div>
            <div class="sub-info" id="inPdInfo">節圓 PD: 28.65 mm</div>
          </div>

          <div class="input-group">
            <label>皮帶輪(輸出) 齒數</label>
            <div class="input-with-unit">
              <input type="number" id="outTeeth" value="36" min="8" max="200" step="1" oninput="onParamChange()" />
              <span class="unit">齒</span>
            </div>
            <div class="sub-info" id="outPdInfo">節圓 PD: 57.30 mm</div>
          </div>

          <div class="input-group">
            <label>兩皮帶輪 X 軸距離</label>
            <div class="input-with-unit">
              <input type="number" id="pulleyDx" value="75" step="0.5" oninput="onParamChange()" />
              <span class="unit">mm</span>
            </div>
          </div>

          <div class="input-group">
            <label>兩皮帶輪 Y 軸距離</label>
            <div class="input-with-unit">
              <input type="number" id="pulleyDy" value="125" step="0.5" oninput="onParamChange()" />
              <span class="unit">mm</span>
            </div>
          </div>
        </div>
        <div class="sub-info" style="margin-top: 8px; color: #cbd5e1;" id="mainCenterDistInfo">
          兩主輪直線中心距 C = 145.77 mm | 減速比 = 1 : 2.00
        </div>
      </div>

      <!-- 2. 模式一專屬：目標皮帶長度設定 -->
      <div class="card" id="mode1Card">
        <div class="card-title">
          <span>2. 固定皮帶長度設定 (模式一)</span>
          <span class="tag">HTD-5M (齒距 5mm)</span>
        </div>
        <div class="grid-2">
          <div class="input-group">
            <label>目標皮帶長度</label>
            <div class="input-with-unit">
              <input type="number" id="targetBeltLength" value="450" min="50" max="5000" step="5" oninput="syncBeltTeethFromLen()" />
              <span class="unit">mm</span>
            </div>
          </div>
          <div class="input-group">
            <label>對應皮帶齒數 (NN)</label>
            <div class="input-with-unit">
              <input type="number" id="targetBeltTeeth" value="90" min="10" max="1000" step="1" oninput="syncBeltLenFromTeeth()" />
              <span class="unit">齒</span>
            </div>
          </div>
        </div>

        <div style="margin-top: 10px; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 8px;">
          <div class="toggle-row">
            <span>🧲 拖動惰輪時自動吸附至「完美張緊軌跡」</span>
            <input type="checkbox" id="snapToTension" checked onchange="onParamChange()" />
          </div>
          <div class="toggle-row">
            <span>🟢 顯示綠色「等皮帶長度張緊軌跡線」</span>
            <input type="checkbox" id="showLocus" checked onchange="onParamChange()" />
          </div>
          <button class="btn-small" style="width:100%; margin-top:6px; padding:7px; font-weight:700; background: var(--accent-green); color:#06281e;" onclick="snapActiveIdlerNow()">
            ⚡ 立即將惰輪自動移至完美張緊位置
          </button>
        </div>
      </div>

      <!-- 3. 惰輪設定與即時座標清單 -->
      <div class="card">
        <div class="card-title">
          <span>3. 培林 / 惰輪參數與相對距離</span>
          <span class="tag" id="idlerCardHint">可於右側畫布直接拖曳惰輪</span>
        </div>
        <div class="grid-2">
          <div class="input-group">
            <label>惰輪預設外徑 (TT)</label>
            <div class="input-with-unit">
              <input type="number" id="defaultIdlerOd" value="22" min="5" max="150" step="0.5" oninput="updateAllIdlersOd()" />
              <span class="unit">mm</span>
            </div>
          </div>
          <div class="input-group">
            <label>惰輪數量</label>
            <select id="idlerCount" onchange="onIdlerCountChange()">
              <option value="0">0 顆 (無惰輪)</option>
              <option value="1">1 顆惰輪</option>
              <option value="2" selected>2 顆惰輪 (如示意圖)</option>
              <option value="3">3 顆惰輪</option>
              <option value="4">4 顆惰輪</option>
            </select>
          </div>
        </div>

        <div class="toggle-row" style="margin-top: 6px;">
          <span title="開啟後將考慮 HTD-5M 皮帶節線偏移 PLD (0.57mm) 與皮帶厚度 (3.8mm)">
            📐 考慮皮帶節線偏移 (關閉則以純圓切線計算)
          </span>
          <input type="checkbox" id="usePitchOffset" onchange="onParamChange()" />
        </div>

        <!-- 動態生成的惰輪控制項 -->
        <div id="idlerListContainer"></div>
      </div>

      <!-- 4. 計算結果輸出面板 -->
      <div class="card">
        <div class="card-title">
          <span>4. 皮帶長度與包角計算結果</span>
          <button class="btn-small" onclick="copyReport()">📋 複製完整參數</button>
        </div>

        <div class="result-grid">
          <div class="result-item">
            <div>
              <div class="r-label">1. 最接近的整數皮帶長度 (比實際大)</div>
              <div class="r-sub" id="stdUpperSub">HTD-5M 標準上限: -- 齒 (-- mm)</div>
            </div>
            <div class="r-value" id="resCeilInt">-- mm</div>
          </div>

          <div class="result-item highlight">
            <div>
              <div class="r-label">2. 實際算出的幾何皮帶長度</div>
              <div class="r-sub" id="exactTeethSub">換算齒數: -- 齒</div>
            </div>
            <div class="r-value" id="resExactLen">-- mm</div>
          </div>

          <div class="result-item">
            <div>
              <div class="r-label">3. 最接近的整數皮帶長度 (比實際小)</div>
              <div class="r-sub" id="stdLowerSub">HTD-5M 標準下限: -- 齒 (-- mm)</div>
            </div>
            <div class="r-value" id="resFloorInt">-- mm</div>
          </div>
        </div>

        <div style="margin-top: 10px; font-size: 0.78rem; color: var(--text-muted); display:flex; justify-content:space-between; flex-wrap:wrap; gap:6px;" id="wrapInfoBar">
          <span>輸入輪嚙合: -- 齒 (--°)</span>
          <span>輸出輪嚙合: -- 齒 (--°)</span>
        </div>
      </div>

    </aside>

    <!-- 右側互動式 CAD 畫布 -->
    <main class="canvas-area">
      <div class="canvas-toolbar">
        <button class="btn-small" onclick="resetView()">🎯 自動置中視角</button>
        <button class="btn-small" onclick="loadDemoPreset()">🖼️ 載入示意圖預設配置</button>
        <span style="font-size: 0.78rem; color: var(--text-muted);">
          💡 提示：直接用滑鼠左鍵<b>拖曳惰輪</b>調整位置；滾輪縮放畫布；按住空白鍵或右鍵拖曳平移畫面。
        </span>
      </div>

      <div class="status-pill" id="tensionStatusBox">
        <div style="font-weight:700; color:#fff;" id="statusTitle">皮帶張緊狀態</div>
        <div id="statusDetail" style="color:#34d399;">計算中...</div>
      </div>

      <canvas id="beltCanvas"></canvas>

      <div class="legend-bar">
        <div class="legend-items">
          <span><i class="dot" style="background:#f472b6;"></i>HTD-5M 輸入/輸出皮帶輪 (節圓+齒形)</span>
          <span><i class="dot" style="background:#94a3b8;"></i>培林/惰輪 (可拖曳)</span>
          <span><i class="dot" style="background:#d6c7b2;"></i>時規皮帶雙層虛線</span>
          <span><i class="dot" style="background:#10b981;"></i>目標皮帶長張緊軌跡 (模式一)</span>
        </div>
        <div id="cursorCoordReadout">游標座標: X: 0.0, Y: 0.0 mm</div>
      </div>
    </main>
  </div>

  <script>
    /**************************************************************
     * 1. 全域狀態與初始設定 (預設對應使用者提供的示意圖配置)
     **************************************************************/
    const PITCH_5M = 5.0;           // HTD-5M 齒距 5mm
    const BELT_THICKNESS = 3.80;    // HTD-5M 皮帶標準總厚度 3.8mm
    const BELT_PLD = 0.57;          // HTD-5M 節線距離齒底偏移量 0.57mm

    let currentMode = 1;            // 1: 固定皮帶長找惰輪位置, 2: 固定位置算皮帶長
    let activeIdlerIndex = 0;       // 當前選中或拖曳的惰輪索引

    // 預設兩顆惰輪：完全呼應示意圖 (一顆在左上段外壓、一顆在右下段內撐)
    let idlers = [
      {
        id: 1,
        od: 22,
        x: 32.0,       // 相對輸入輪 X (mm)
        y: 52.0,       // 相對輸入輪 Y (mm)
        span: 'upper', // 'upper': 左/上側皮帶段(輸入->輸出), 'lower': 右/下側皮帶段(輸出->輸入)
        wrapType: 'outside' // 'outside': 外壓(背側), 'inside': 內撐(齒側)
      },
      {
        id: 2,
        od: 22,
        x: 68.0,
        y: 26.0,
        span: 'lower',
        wrapType: 'inside'
      }
    ];

    // 畫布視角狀態 (Pan & Zoom)
    const view = {
      scale: 2.6,      // 每 mm 對應像素
      offsetX: 0,
      offsetY: 0,
      isDraggingIdler: false,
      draggingIdx: -1,
      isPanning: false,
      panStartX: 0,
      panStartY: 0
    };

    const canvas = document.getElementById('beltCanvas');
    const ctx = canvas.getContext('2d');

    /**************************************************************
     * 2. 核心幾何與切線計算引擎 (支援任意圓內/外公切線與包角)
     **************************************************************/
    function getPulleyPitchRadius(teeth) {
      return (teeth * PITCH_5M) / (2 * Math.PI);
    }

    function getIdlerEffectiveRadius(idler, useOffset) {
      const baseR = idler.od / 2.0;
      if (!useOffset) return baseR;
      // 若為內撐(接觸齒側)，節線在半徑外移 PLD；若為外壓(接觸皮帶背面)，節線在半徑外移 (皮帶厚度 - PLD)
      if (idler.wrapType === 'inside') {
        return baseR + BELT_PLD;
      } else {
        return baseR + (BELT_THICKNESS - BELT_PLD);
      }
    }

    /**
     * 計算從輪 A 到輪 B 的有向公切線
     * 在順時針(CW)主迴路中：
     *   s = +1 代表輪子在皮帶行進方向的右側 (主皮帶輪、內撐惰輪) -> 順時針繞行
     *   s = -1 代表輪子在皮帶行進方向的左側 (外壓背側惰輪) -> 逆時針繞行
     */
    function computeDirectedTangent(c1, c2) {
      const dx = c2.x - c1.x;
      const dy = c2.y - c1.y;
      const D = Math.hypot(dx, dy);
      const dr = c1.s * c1.r - c2.s * c2.r;

      if (D < 1e-6 || Math.abs(dr) >= D) {
        return { valid: false, D, error: '輪距過近或重疊，無法形成公切線' };
      }

      const theta0 = Math.atan2(dy, dx);
      const ratio = Math.max(-1, Math.min(1, dr / D));
      const beta = Math.acos(ratio);
      // 左法線方向角 alpha
      const alpha = theta0 + beta;
      const nx = Math.cos(alpha);
      const ny = Math.sin(alpha);

      // 兩圓上的切點座標
      const t1x = c1.x + c1.s * c1.r * nx;
      const t1y = c1.y + c1.s * c1.r * ny;
      const t2x = c2.x + c2.s * c2.r * nx;
      const t2y = c2.y + c2.s * c2.r * ny;

      // 圓心指向切點的極角
      const radialAngle1 = Math.atan2(t1y - c1.y, t1x - c1.x);
      const radialAngle2 = Math.atan2(t2y - c2.y, t2x - c2.x);

      const segLen = Math.sqrt(Math.max(0, D * D - dr * dr));

      return {
        valid: true,
        t1: { x: t1x, y: t1y },
        t2: { x: t2x, y: t2y },
        nx, ny,
        radialAngle1,
        radialAngle2,
        segLen
      };
    }

    /**
     * 給定目前所有參數，計算完整皮帶迴路幾何與總長度
     */
    function solveBeltSystem(customIdlers = null) {
      const inTeeth = parseFloat(document.getElementById('inTeeth').value) || 18;
      const outTeeth = parseFloat(document.getElementById('outTeeth').value) || 36;
      const dx = parseFloat(document.getElementById('pulleyDx').value) || 0;
      const dy = parseFloat(document.getElementById('pulleyDy').value) || 0;
      const useOffset = document.getElementById('usePitchOffset').checked;

      const rIn = getPulleyPitchRadius(inTeeth);
      const rOut = getPulleyPitchRadius(outTeeth);

      const pIn = {
        name: '輸入皮帶輪',
        role: 'pulley_in',
        teeth: inTeeth,
        x: 0,
        y: 0,
        r: rIn,
        drawR: rIn,
        s: +1
      };

      const pOut = {
        name: '輸出皮帶輪',
        role: 'pulley_out',
        teeth: outTeeth,
        x: dx,
        y: dy,
        r: rOut,
        drawR: rOut,
        s: +1
      };

      const activeList = customIdlers || idlers;
      const mainDist = Math.hypot(dx, dy);
      const ux = mainDist > 1e-6 ? dx / mainDist : 1;
      const uy = mainDist > 1e-6 ? dy / mainDist : 0;

      // 將惰輪依所屬支路分類並沿支路行進方向排序
      const upperIdlers = [];
      const lowerIdlers = [];

      activeList.forEach((idl, idx) => {
        const effR = getIdlerEffectiveRadius(idl, useOffset);
        const node = {
          name: `惰輪 #${idx + 1}`,
          role: 'idler',
          idlerIndex: idx,
          od: idl.od,
          x: idl.x,
          y: idl.y,
          r: effR,
          drawR: idl.od / 2.0,
          s: idl.wrapType === 'inside' ? +1 : -1,
          wrapType: idl.wrapType,
          span: idl.span,
          proj: idl.x * ux + idl.y * uy
        };
        if (idl.span === 'upper') upperIdlers.push(node);
        else lowerIdlers.push(node);
      });

      upperIdlers.sort((a, b) => a.proj - b.proj);
      lowerIdlers.sort((a, b) => b.proj - a.proj);

      // 依順時針迴路串接：輸入輪 -> 上/左段惰輪 -> 輸出輪 -> 下/右段惰輪 -> (回到輸入輪)
      const chain = [pIn, ...upperIdlers, pOut, ...lowerIdlers];
      const n = chain.length;
      const segments = [];
      let totalStraight = 0;
      let allValid = true;
      let errorMsg = '';

      for (let i = 0; i < n; i++) {
        const c1 = chain[i];
        const c2 = chain[(i + 1) % n];
        const seg = computeDirectedTangent(c1, c2);
        if (!seg.valid) {
          allValid = false;
          errorMsg = seg.error;
        }
        segments.push(seg);
        if (seg.valid) totalStraight += seg.segLen;
      }

      // 計算每個輪子上的包角與弧長
      let totalArc = 0;
      let nonContactWarning = false;

      for (let i = 0; i < n; i++) {
        const wheel = chain[i];
        const prevSeg = segments[(i - 1 + n) % n];
        const nextSeg = segments[i];

        if (!prevSeg.valid || !nextSeg.valid) {
          wheel.wrapAngle = 0;
          wheel.arcLen = 0;
          continue;
        }

        const angIn = prevSeg.radialAngle2;
        const angOut = nextSeg.radialAngle1;

        // s = +1 為順時針繞行 (角度遞減: angIn - angOut)
        // s = -1 為逆時針繞行 (角度遞增: angOut - angIn)
        let delta = wheel.s === 1 ? (angIn - angOut) : (angOut - angIn);
        delta = ((delta % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI);

        // 針對惰輪：若拉到未壓到皮帶的反向側，delta 會接近 2*PI，將其映射至 [-PI/2, 3*PI/2] 避免跳變
        if (wheel.role === 'idler' && delta > 1.5 * Math.PI) {
          delta = delta - 2 * Math.PI;
        }
        if (wheel.role === 'idler' && delta < 0) {
          nonContactWarning = true;
          delta = 0; // 未壓入皮帶時不計反向繞圈
        }

        wheel.angIn = angIn;
        wheel.angOut = angOut;
        wheel.wrapAngle = delta;
        wheel.arcLen = wheel.r * delta;
        totalArc += wheel.arcLen;
      }

      const totalLength = allValid ? (totalStraight + totalArc) : 0;

      return {
        valid: allValid,
        errorMsg,
        nonContactWarning,
        pIn,
        pOut,
        chain,
        segments,
        totalLength,
        mainDist
      };
    }

    /**************************************************************
     * 3. 模式一：牛頓梯度投影法 (自動吸附至完美張緊軌跡)
     **************************************************************/
    function evaluateLengthWithIdlerAt(idx, x, y) {
      const cloned = idlers.map((it, i) => i === idx ? { ...it, x, y } : { ...it });
      const res = solveBeltSystem(cloned);
      return res.valid ? res.totalLength : null;
    }

    function projectIdlerToTargetLength(idx, startX, startY, targetL) {
      let x = startX;
      let y = startY;
      const eps = 0.05;

      for (let iter = 0; iter < 8; iter++) {
        const L0 = evaluateLengthWithIdlerAt(idx, x, y);
        if (L0 === null) break;
        const err = L0 - targetL;
        if (Math.abs(err) < 0.005) break;

        const Lx = evaluateLengthWithIdlerAt(idx, x + eps, y);
        const Ly = evaluateLengthWithIdlerAt(idx, x, y + eps);
        if (Lx === null || Ly === null) break;

        const gx = (Lx - L0) / eps;
        const gy = (Ly - L0) / eps;
        const gNormSq = gx * gx + gy * gy;
        if (gNormSq < 1e-6) break;

        // 限制單步最大位移避免發散
        let stepX = -(err * gx) / gNormSq;
        let stepY = -(err * gy) / gNormSq;
        const stepMag = Math.hypot(stepX, stepY);
        if (stepMag > 25) {
          stepX = (stepX / stepMag) * 25;
          stepY = (stepY / stepMag) * 25;
        }

        x += stepX;
        y += stepY;
      }

      return { x, y };
    }

    function snapActiveIdlerNow() {
      if (idlers.length === 0) return;
      const idx = Math.min(activeIdlerIndex, idlers.length - 1);
      const targetL = parseFloat(document.getElementById('targetBeltLength').value) || 450;
      const snapped = projectIdlerToTargetLength(idx, idlers[idx].x, idlers[idx].y, targetL);
      idlers[idx].x = Number(snapped.x.toFixed(2));
      idlers[idx].y = Number(snapped.y.toFixed(2));
      renderIdlerControls();
      updateCalculationAndRender();
    }

