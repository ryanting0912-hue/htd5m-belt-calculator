     * 4. 介面互動與動態表單控制
     **************************************************************/
    function switchMode(mode) {
      currentMode = mode;
      document.getElementById('tabMode1').classList.toggle('active', mode === 1);
      document.getElementById('tabMode2').classList.toggle('active', mode === 2);
      document.getElementById('mode1Card').style.display = mode === 1 ? 'block' : 'none';
      document.getElementById('idlerCardHint').textContent =
        mode === 1 ? '模式一：拖曳畫布惰輪找張緊點' : '模式二：輸入座標或拖曳微調';
      renderIdlerControls();
      updateCalculationAndRender();
    }

    function syncBeltTeethFromLen() {
      const len = parseFloat(document.getElementById('targetBeltLength').value) || 0;
      document.getElementById('targetBeltTeeth').value = (len / PITCH_5M).toFixed(1).replace(/\.0$/, '');
      onParamChange();
    }

    function syncBeltLenFromTeeth() {
      const teeth = parseFloat(document.getElementById('targetBeltTeeth').value) || 0;
      document.getElementById('targetBeltLength').value = (teeth * PITCH_5M).toFixed(1).replace(/\.0$/, '');
      onParamChange();
    }

    function updateAllIdlersOd() {
      const newOd = parseFloat(document.getElementById('defaultIdlerOd').value) || 22;
      idlers.forEach(idl => { idl.od = newOd; });
      renderIdlerControls();
      updateCalculationAndRender();
    }

    function onIdlerCountChange() {
      const count = parseInt(document.getElementById('idlerCount').value, 10);
      const defaultOd = parseFloat(document.getElementById('defaultIdlerOd').value) || 22;
      const dx = parseFloat(document.getElementById('pulleyDx').value) || 75;
      const dy = parseFloat(document.getElementById('pulleyDy').value) || 125;

      while (idlers.length < count) {
        const idx = idlers.length;
        const isUpper = idx % 2 === 0;
        idlers.push({
          id: idx + 1,
          od: defaultOd,
          x: Number((dx * (0.35 + 0.15 * idx) + (isUpper ? -15 : 18)).toFixed(1)),
          y: Number((dy * (0.35 + 0.15 * idx) + (isUpper ? 10 : -15)).toFixed(1)),
          span: isUpper ? 'upper' : 'lower',
          wrapType: isUpper ? 'outside' : 'inside'
        });
      }
      if (idlers.length > count) {
        idlers.length = count;
      }
      activeIdlerIndex = Math.max(0, Math.min(activeIdlerIndex, idlers.length - 1));
      renderIdlerControls();
      updateCalculationAndRender();
    }

    function renderIdlerControls() {
      const container = document.getElementById('idlerListContainer');
      const dxOut = parseFloat(document.getElementById('pulleyDx').value) || 0;
      const dyOut = parseFloat(document.getElementById('pulleyDy').value) || 0;

      if (idlers.length === 0) {
        container.innerHTML = `<div style="font-size:0.8rem; color:var(--text-muted); padding:8px 0;">目前設定為 0 顆惰輪（僅計算兩主皮帶輪直接傳動）。</div>`;
        return;
      }

      container.innerHTML = idlers.map((idl, idx) => {
        const relOutX = idl.x - dxOut;
        const relOutY = idl.y - dyOut;
        const distIn = Math.hypot(idl.x, idl.y);
        const distOut = Math.hypot(relOutX, relOutY);
        const isSelected = idx === activeIdlerIndex;

        return `
          <div class="idler-box" style="border-left-color: ${isSelected ? '#10b981' : '#f59e0b'};" onclick="selectIdler(${idx})">
            <div class="idler-header">
              <span>⚙️ 惰輪 #${idx + 1}${isSelected ? '(目前作用中)' : ''}</span>
              <button class="btn-small" onclick="event.stopPropagation(); copySingleIdler(${idx})">複製此惰輪座標</button>
            </div>
            <div class="grid-3">
              <div class="input-group">
                <label>外徑 (OD)</label>
                <div class="input-with-unit">
                  <input type="number" value="${idl.od}" step="0.5" oninput="updateIdlerField(${idx}, 'od', this.value)" />
                  <span class="unit">mm</span>
                </div>
              </div>
              <div class="input-group">
                <label>安裝皮帶段</label>
                <select onchange="updateIdlerField(${idx}, 'span', this.value)">
                  <option value="upper" ${idl.span === 'upper' ? 'selected' : ''}>上/左段 (去程)</option>
                  <option value="lower" ${idl.span === 'lower' ? 'selected' : ''}>下/右段 (回程)</option>
                </select>
              </div>
              <div class="input-group">
                <label>壓緊方向</label>
                <select onchange="updateIdlerField(${idx}, 'wrapType', this.value)">
                  <option value="outside" ${idl.wrapType === 'outside' ? 'selected' : ''}>外壓 (壓背側)</option>
                  <option value="inside" ${idl.wrapType === 'inside' ? 'selected' : ''}>內撐 (壓齒側)</option>
                </select>
              </div>
            </div>
            <div class="grid-2">
              <div class="input-group">
                <label>與輸入輪 X 距離</label>
                <div class="input-with-unit">
                  <input type="number" id="idlX_${idx}" value="${idl.x.toFixed(2)}" step="0.5" oninput="updateIdlerField(${idx}, 'x', this.value)" />
                  <span class="unit">mm</span>
                </div>
              </div>
              <div class="input-group">
                <label>與輸入輪 Y 距離</label>
                <div class="input-with-unit">
                  <input type="number" id="idlY_${idx}" value="${idl.y.toFixed(2)}" step="0.5" oninput="updateIdlerField(${idx}, 'y', this.value)" />
                  <span class="unit">mm</span>
                </div>
              </div>
            </div>
            <div class="relative-readout" id="idlReadout_${idx}">
              <div>📍 <b>相對輸入輪：</b>ΔX = ${idl.x.toFixed(2)} mm, ΔY = ${idl.y.toFixed(2)} mm (軸距 ${distIn.toFixed(2)} mm)</div>
              <div>📍 <b>相對輸出輪：</b>ΔX = ${relOutX.toFixed(2)} mm, ΔY = ${relOutY.toFixed(2)} mm (軸距 ${distOut.toFixed(2)} mm)</div>
            </div>
          </div>
        `;
      }).join('');
    }

    function selectIdler(idx) {
      activeIdlerIndex = idx;
      renderIdlerControls();
      drawCanvas();
    }

    function updateIdlerField(idx, field, val) {
      activeIdlerIndex = idx;
      if (field === 'span' || field === 'wrapType') {
        idlers[idx][field] = val;
        renderIdlerControls();
      } else {
        idlers[idx][field] = parseFloat(val) || 0;
        updateIdlerReadoutDOM(idx);
      }
      updateCalculationAndRender();
    }

    function updateIdlerReadoutDOM(idx) {
      const idl = idlers[idx];
      if (!idl) return;
      const dxOut = parseFloat(document.getElementById('pulleyDx').value) || 0;
      const dyOut = parseFloat(document.getElementById('pulleyDy').value) || 0;
      const relOutX = idl.x - dxOut;
      const relOutY = idl.y - dyOut;
      const distIn = Math.hypot(idl.x, idl.y);
      const distOut = Math.hypot(relOutX, relOutY);

      const xInput = document.getElementById(`idlX_${idx}`);
      const yInput = document.getElementById(`idlY_${idx}`); if (xInput && document.activeElement !== xInput) xInput.value = idl.x.toFixed(2); if (yInput && document.activeElement !== yInput) yInput.value = idl.y.toFixed(2);  const readout = document.getElementById(`idlReadout_${idx}`);
      if (readout) {
        readout.innerHTML = `
          <div>📍 <b>相對輸入輪：</b>ΔX = ${idl.x.toFixed(2)} mm, ΔY = ${idl.y.toFixed(2)} mm (軸距 ${distIn.toFixed(2)} mm)</div>
          <div>📍 <b>相對輸出輪：</b>ΔX = ${relOutX.toFixed(2)} mm, ΔY = ${relOutY.toFixed(2)} mm (軸距 ${distOut.toFixed(2)} mm)</div>
        `;
      }
    }

    function onParamChange() {
      idlers.forEach((_, idx) => updateIdlerReadoutDOM(idx));
      updateCalculationAndRender();
    }

    /**************************************************************
     * 5. 更新計算結果與狀態顯示
     **************************************************************/
    let latestSolution = null;

    function updateCalculationAndRender() {
      const sol = solveBeltSystem();
      latestSolution = sol;

      // 更新主皮帶輪節圓資訊
      document.getElementById('inPdInfo').textContent = `節圓 PD: ${(sol.pIn.r * 2).toFixed(2)} mm`; document.getElementById('outPdInfo').textContent = `節圓 PD: ${(sol.pOut.r * 2).toFixed(2)} mm`;
      const ratio = (sol.pOut.teeth / sol.pIn.teeth).toFixed(2);
      document.getElementById('mainCenterDistInfo').textContent =
        `兩主輪直線中心距 C = ${sol.mainDist.toFixed(2)} mm \vert{} 齒數比 = 1 : ${ratio}`;

      if (!sol.valid) {
        document.getElementById('resCeilInt').textContent = '幾何錯誤';
        document.getElementById('resExactLen').textContent = sol.errorMsg;
        document.getElementById('resFloorInt').textContent = '幾何錯誤';
        drawCanvas();
        return;
      }

      const exactL = sol.totalLength;
      // 1. 比實際大的最接近整數 (若剛好整數則 +1，或依 ceil 處理)
      const ceilInt = Math.floor(exactL) + 1;
      // 3. 比實際小的最接近整數
      const floorInt = Math.ceil(exactL) - 1;

      // HTD-5M 標準 5mm 倍數皮帶規格
      const upperTeeth5M = Math.ceil(exactL / PITCH_5M);
      const lowerTeeth5M = Math.floor(exactL / PITCH_5M);
      const upperLen5M = upperTeeth5M * PITCH_5M;
      const lowerLen5M = lowerTeeth5M * PITCH_5M;

      document.getElementById('resCeilInt').textContent = `${ceilInt} mm`; document.getElementById('stdUpperSub').textContent = `HTD-5M 標準上限: ${upperTeeth5M} 齒 (${upperLen5M} mm, 餘裕 +${(upperLen5M - exactL).toFixed(2)} mm)`;

      document.getElementById('resExactLen').textContent = `${exactL.toFixed(2)} mm`; document.getElementById('exactTeethSub').textContent = `換算精確齒數: ${(exactL / PITCH_5M).toFixed(2)} 齒`;

      document.getElementById('resFloorInt').textContent = `${floorInt} mm`; document.getElementById('stdLowerSub').textContent = `HTD-5M 標準下限: ${lowerTeeth5M} 齒 (${lowerLen5M} mm, 差 ${(exactL - lowerLen5M).toFixed(2)} mm)`;

      // 包角與嚙合齒數計算
      const inWrapDeg = (sol.pIn.wrapAngle * 180) / Math.PI;
      const outWrapDeg = (sol.pOut.wrapAngle * 180) / Math.PI;
      const inTIM = (sol.pIn.teeth * sol.pIn.wrapAngle) / (2 * Math.PI);
      const outTIM = (sol.pOut.teeth * sol.pOut.wrapAngle) / (2 * Math.PI);

      document.getElementById('wrapInfoBar').innerHTML = `
        <span style="color:${inTIM < 6 ? '#f87171' : '#a7f3d0'};">
          輸入輪包角: ${inWrapDeg.toFixed(1)}° (嚙合 ${inTIM.toFixed(1)} 齒 ${inTIM < 6 ? '⚠️偏少' : '✓'})
        </span>
        <span style="color:${outTIM < 6 ? '#f87171' : '#a7f3d0'};">
          輸出輪包角: ${outWrapDeg.toFixed(1)}° (嚙合 ${outTIM.toFixed(1)} 齒 ${outTIM < 6 ? '⚠️偏少' : '✓'})
        </span>
      `;

      // 右上角狀態膠囊更新
      const statusTitle = document.getElementById('statusTitle');
      const statusDetail = document.getElementById('statusDetail');
      if (currentMode === 1) {
        const targetL = parseFloat(document.getElementById('targetBeltLength').value) || 450;
        const diff = exactL - targetL;
        statusTitle.textContent = `模式一：目標皮帶 ${targetL.toFixed(1)} mm (${(targetL / 5).toFixed(0)} 齒)`;
        if (Math.abs(diff) <= 0.5) {
          statusDetail.style.color = '#34d399';
          statusDetail.innerHTML = `✅ <b>完美張緊！</b> 當前幾何長度 ${exactL.toFixed(2)} mm (誤差 ${diff >= 0 ? '+' : ''}${diff.toFixed(2)} mm)`; } else if (diff < 0) { statusDetail.style.color = '#fbbf24'; statusDetail.innerHTML = `⚠️ <b>皮帶尚有餘裕 (偏鬆)</b>：還需張緊 ${( -diff ).toFixed(2)} mm (當前 ${exactL.toFixed(2)} mm)`; } else { statusDetail.style.color = '#f87171'; statusDetail.innerHTML = `❌ <b>皮帶過緊 (超出長度)</b>：超出目標 +${diff.toFixed(2)} mm (當前 ${exactL.toFixed(2)} mm)`; } } else { statusTitle.textContent = `模式二：實際算出皮帶長 ${exactL.toFixed(2)} mm`;
        statusDetail.style.color = '#60a5fa';
        statusDetail.innerHTML = `建議選用標準皮帶：<b>${upperTeeth5M} 齒 (${upperLen5M} mm)</b> 或 <b>${lowerTeeth5M} 齒 (${lowerLen5M} mm)</b>`;
      }

      drawCanvas();
    }

    /**************************************************************
     * 6. 畫布視覺化渲染 (仿使用者 CAD 示意圖風格)
     **************************************************************/
    function worldToScreen(wx, wy) {
      return {
        x: view.offsetX + wx * view.scale,
        y: view.offsetY - wy * view.scale // Y軸向上為正
      };
    }

    function screenToWorld(sx, sy) {
      return {
        x: (sx - view.offsetX) / view.scale,
        y: (view.offsetY - sy) / view.scale
      };
    }

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width * window.devicePixelRatio;
      canvas.height = rect.height * window.devicePixelRatio;
      ctx.setTransform(window.devicePixelRatio, 0, 0, window.devicePixelRatio, 0, 0);
      if (view.offsetX === 0 && view.offsetY === 0) {
        resetView();
      } else {
        drawCanvas();
      }
    }

    function resetView() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const dx = parseFloat(document.getElementById('pulleyDx').value) || 75;
      const dy = parseFloat(document.getElementById('pulleyDy').value) || 125;

      let minX = Math.min(0, dx) - 45;
      let maxX = Math.max(0, dx) + 45;
      let minY = Math.min(0, dy) - 45;
      let maxY = Math.max(0, dy) + 45;

      idlers.forEach(idl => {
        minX = Math.min(minX, idl.x - idl.od);
        maxX = Math.max(maxX, idl.x + idl.od);
        minY = Math.min(minY, idl.y - idl.od);
        maxY = Math.max(maxY, idl.y + idl.od);
      });

      const wWorld = Math.max(100, maxX - minX);
      const hWorld = Math.max(100, maxY - minY);
      const pad = 110;

      const scaleX = (rect.width - pad * 2) / wWorld;
      const scaleY = (rect.height - pad * 2) / hWorld;
      view.scale = Math.max(0.5, Math.min(6, Math.min(scaleX, scaleY)));

      const cx = (minX + maxX) / 2;
      const cy = (minY + maxY) / 2;
      view.offsetX = rect.width / 2 - cx * view.scale;
      view.offsetY = rect.height / 2 + cy * view.scale;

      drawCanvas();
    }

    /**
     * 繪製模式一的「等皮帶長度張緊軌跡線 (Iso-Length Contour)」
     */
    function drawTensionLocus(targetL) {
      if (idlers.length === 0) return;
      const idx = Math.min(activeIdlerIndex, idlers.length - 1);
      const rect = canvas.parentElement.getBoundingClientRect();
      const stepPx = 14; // 網格取樣間距 (px)
      const cols = Math.ceil(rect.width / stepPx);
      const rows = Math.ceil(rect.height / stepPx);

      const grid = [];
      for (let r = 0; r <= rows; r++) {
        const rowArr = [];
        for (let c = 0; c <= cols; c++) {
          const wpt = screenToWorld(c * stepPx, r * stepPx);
          const L = evaluateLengthWithIdlerAt(idx, wpt.x, wpt.y);
          rowArr.push(L !== null ? L - targetL : NaN);
        }
        grid.push(rowArr);
      }

      ctx.save();
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.75)';
      ctx.lineWidth = 2.2;
      ctx.setLineDash([6, 4]);
      ctx.beginPath();

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const v00 = grid[r][c];
          const v10 = grid[r][c + 1];
          const v01 = grid[r + 1][c];
          const v11 = grid[r + 1][c + 1];
          if (isNaN(v00) || isNaN(v10) || isNaN(v01) || isNaN(v11)) continue;

          const pts = [];
          if (v00 * v10 <= 0 && v00 !== v10) {
            const t = v00 / (v00 - v10);
            pts.push({ x: (c + t) * stepPx, y: r * stepPx });
          }
          if (v10 * v11 <= 0 && v10 !== v11) {
            const t = v10 / (v10 - v11);
            pts.push({ x: (c + 1) * stepPx, y: (r + t) * stepPx });
          }
          if (v01 * v11 <= 0 && v01 !== v11) {
            const t = v01 / (v01 - v11);
            pts.push({ x: (c + t) * stepPx, y: (r + 1) * stepPx });
          }
          if (v00 * v01 <= 0 && v00 !== v01) {
            const t = v00 / (v00 - v01);
            pts.push({ x: c * stepPx, y: (r + t) * stepPx });
          }
          if (pts.length >= 2) {
            ctx.moveTo(pts[0].x, pts[0].y);
            ctx.lineTo(pts[1].x, pts[1].y);
          }
        }
      }
      ctx.stroke();
      ctx.restore();
    }

    /**
     * 繪製仿 CAD 示意圖風格的 HTD-5M 皮帶輪 (含粉紅剖面、齒形與六角孔)
     */
    function drawCADPulley(wheel, labelText) {
      const center = worldToScreen(wheel.x, wheel.y);
      const rPx = wheel.drawR * view.scale;
      const teeth = wheel.teeth;

      ctx.save();
      ctx.translate(center.x, center.y);

      // 1. 外圈深灰齒形底環
      ctx.beginPath();
      ctx.arc(0, 0, rPx * 1.04, 0, Math.PI * 2);
      ctx.fillStyle = '#26292e';
      ctx.fill();
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = '#9ca3af';
      ctx.stroke();

      // 2. 粉紅本體環 (呼應示意圖配色)
      ctx.beginPath();
      ctx.arc(0, 0, rPx * 0.94, 0, Math.PI * 2);
      ctx.fillStyle = '#f4a2b8';
      ctx.fill();
      ctx.strokeStyle = '#1f2937';
      ctx.stroke();

      // 3. 繪製 HTD 圓弧齒槽
      ctx.fillStyle = '#1e2229';
      for (let i = 0; i < teeth; i++) {
        const ang = (i * 2 * Math.PI) / teeth;
        const tx = Math.cos(ang) * (rPx * 0.96);
        const ty = Math.sin(ang) * (rPx * 0.96);
        ctx.beginPath();
        ctx.arc(tx, ty, Math.max(1.8, (rPx * Math.PI) / (teeth * 2.2)), 0, Math.PI * 2);
        ctx.fill();
      }

      // 4. 內圈深色減重槽 (大型皮帶輪顯示)
      if (teeth >= 24) {
        ctx.beginPath();
        ctx.arc(0, 0, rPx * 0.68, 0, Math.PI * 2);
        ctx.fillStyle = '#32363e';
        ctx.fill();
        ctx.strokeStyle = '#111';
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(0, 0, rPx * 0.36, 0, Math.PI * 2);
        ctx.fillStyle = '#f4a2b8';
        ctx.fill();
        ctx.stroke();
      }

      // 5. 中心六角軸孔 (1/2" Hex Bore 示意)
      const hexR = Math.min(rPx * 0.45, Math.max(7 * view.scale, 10));
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const a = (i * Math.PI) / 3 + Math.PI / 6;
        const hx = Math.cos(a) * hexR;
        const hy = Math.sin(a) * hexR;
        if (i === 0) ctx.moveTo(hx, hy);
        else ctx.lineTo(hx, hy);
      }
      ctx.closePath();
      ctx.fillStyle = '#334155';
      ctx.fill();
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = '#0f172a';
      ctx.stroke();

      // 6. 節圓參考虛線
      ctx.beginPath();
      ctx.setLineDash([4, 3]);
      ctx.arc(0, 0, wheel.r * view.scale, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255,255,255,0.4)';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.restore();

      // 7. 標籤文字
      ctx.save();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 12px "Microsoft JhengHei", sans-serif';
      const labelY = wheel.role === 'pulley_in' ? center.y + rPx + 20 : center.y - rPx - 12;
      ctx.textAlign = 'center';
      ctx.fillText(labelText, center.x, labelY);
      ctx.restore();
    }

    /**
     * 繪製培林或惰輪 (可拖曳互動元件)
     */
    function drawCADIdler(wheel, isSelected) {
      const center = worldToScreen(wheel.x, wheel.y);
      const rPx = wheel.drawR * view.scale;

      ctx.save();
      ctx.translate(center.x, center.y);

      // 選中光暈
      if (isSelected) {
        ctx.beginPath();
        ctx.arc(0, 0, rPx + 6, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(16, 185, 129, 0.25)';
        ctx.fill();
        ctx.strokeStyle = '#10b981';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      // 培林外環
      ctx.beginPath();
      ctx.arc(0, 0, rPx, 0, Math.PI * 2);
      ctx.fillStyle = '#646b78';
      ctx.fill();
      ctx.lineWidth = 1.8;
      ctx.strokeStyle = isSelected ? '#34d399' : '#1e293b';
      ctx.stroke();

      // 培林防塵蓋內圈
      ctx.beginPath();
      ctx.arc(0, 0, rPx * 0.76, 0, Math.PI * 2);
      ctx.strokeStyle = '#2d323b';
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // 內環與中心孔
      ctx.beginPath();
      ctx.arc(0, 0, rPx * 0.42, 0, Math.PI * 2);
      ctx.fillStyle = '#334155';
      ctx.fill();
      ctx.strokeStyle = '#cbd5e1';
      ctx.stroke();

      ctx.restore();

      // 惰輪文字與即時座標標註
      ctx.save();
      ctx.fillStyle = isSelected ? '#6ee7b7' : '#f8fafc';
      ctx.font = 'bold 12px "Microsoft JhengHei", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(
        `${wheel.name} (外徑 ${wheel.od}mm | ${wheel.wrapType === 'outside' ? '外壓' : '內撐'})`, center.x, center.y - rPx - 16 ); ctx.font = '11px monospace'; ctx.fillStyle = '#fde68a'; ctx.fillText( `(${wheel.x.toFixed(1)}, ${wheel.y.toFixed(1)})`, center.x, center.y - rPx - 3 ); ctx.restore(); }  function drawCanvas() { const rect = canvas.parentElement.getBoundingClientRect(); ctx.clearRect(0, 0, rect.width, rect.height);  // 1. 繪製背景座標網格 const stepWorld = view.scale > 1.8 ? 10 : 25; const topLeft = screenToWorld(0, 0); const bottomRight = screenToWorld(rect.width, rect.height);  ctx.save(); ctx.lineWidth = 1; for (let x = Math.floor(topLeft.x / stepWorld) * stepWorld; x <= bottomRight.x; x += stepWorld) { const sx = worldToScreen(x, 0).x; ctx.strokeStyle = x === 0 ? 'rgba(59, 130, 246, 0.45)' : 'rgba(255, 255, 255, 0.05)'; ctx.beginPath(); ctx.moveTo(sx, 0); ctx.lineTo(sx, rect.height); ctx.stroke(); } for (let y = Math.floor(bottomRight.y / stepWorld) * stepWorld; y <= topLeft.y; y += stepWorld) { const sy = worldToScreen(0, y).y; ctx.strokeStyle = y === 0 ? 'rgba(59, 130, 246, 0.45)' : 'rgba(255, 255, 255, 0.05)'; ctx.beginPath(); ctx.moveTo(0, sy); ctx.lineTo(rect.width, sy); ctx.stroke(); } ctx.restore();  if (!latestSolution) return; const sol = latestSolution;  // 2. 繪製兩皮帶輪的矩形基準外框 (仿示意圖中的白色基準框) const pInScr = worldToScreen(sol.pIn.x, sol.pIn.y); const pOutScr = worldToScreen(sol.pOut.x, sol.pOut.y); ctx.save(); ctx.strokeStyle = 'rgba(226, 232, 240, 0.55)'; ctx.lineWidth = 1.5; ctx.fillStyle = 'rgba(148, 163, 184, 0.08)'; const boxX = Math.min(pInScr.x, pOutScr.x); const boxY = Math.min(pInScr.y, pOutScr.y); const boxW = Math.abs(pOutScr.x - pInScr.x); const boxH = Math.abs(pOutScr.y - pInScr.y); ctx.fillRect(boxX, boxY, boxW, boxH); ctx.strokeRect(boxX, boxY, boxW, boxH); ctx.restore();  // 3. 模式一：繪製綠色張緊軌跡線 if (currentMode === 1 && document.getElementById('showLocus').checked && idlers.length > 0) { const targetL = parseFloat(document.getElementById('targetBeltLength').value) \vert{}\vert{} 450; drawTensionLocus(targetL); }  // 4. 繪製皮帶輪與惰輪實體 drawCADPulley(sol.pIn, `HTD-5M 輸入皮帶輪 ${sol.pIn.teeth} 齒 (0, 0)`);
      drawCADPulley(sol.pOut, `HTD-5M 輸出皮帶輪 ${sol.pOut.teeth} 齒 (${sol.pOut.x}, ${sol.pOut.y})`);  sol.chain.forEach(w => { if (w.role === 'idler') { drawCADIdler(w, w.idlerIndex === activeIdlerIndex); } });  // 5. 繪製皮帶雙層平行虛線 (完全還原示意圖中的雙虛線皮帶視覺) if (sol.valid) { const beltVisualThickPx = Math.max(4, 3.2 * view.scale); const offsets = [0, beltVisualThickPx]; // 內層切線與外層皮帶背線  offsets.forEach((offsetPx, layerIdx) => { ctx.save(); ctx.setLineDash([9, 5]); ctx.lineWidth = layerIdx === 0 ? 1.8 : 1.4;  // 根據模式一的張緊誤差決定皮帶顏色 let strokeCol = '#d6c7b2'; // 預設仿 CAD 米金虛線色 if (currentMode === 1) { const targetL = parseFloat(document.getElementById('targetBeltLength').value) \vert{}\vert{} 450; const diff = Math.abs(sol.totalLength - targetL); if (diff <= 0.6) strokeCol = '#6ee7b7'; else if (sol.totalLength > targetL) strokeCol = '#fca5a5'; } ctx.strokeStyle = strokeCol;  // 繪製直線切線段 sol.segments.forEach(seg => { if (!seg.valid) return; const p1 = worldToScreen(seg.t1.x, seg.t1.y); const p2 = worldToScreen(seg.t2.x, seg.t2.y); // 左法線在螢幕座標為 (nx, -ny) const snx = seg.nx * offsetPx; const sny = -seg.ny * offsetPx;  ctx.beginPath(); ctx.moveTo(p1.x + snx, p1.y + sny); ctx.lineTo(p2.x + snx, p2.y + sny); ctx.stroke(); });  // 繪製輪上包角弧線段 sol.chain.forEach(w => { if (w.wrapAngle <= 0.001) return; const cScr = worldToScreen(w.x, w.y); // 當 s = +1 (內側輪) 時外層皮帶半徑較大；當 s = -1 (外壓輪) 時外層皮帶半徑較小 const arcRadiusPx = w.r * view.scale + w.s * offsetPx; if (arcRadiusPx <= 1) return;  ctx.beginPath(); // 世界座標極角 theta 轉換為 Canvas 螢幕順時針極角為 -theta // 世界座標 s = +1 (順時針) 在 Canvas 中為順時針 (counterclockwise = false) ctx.arc( cScr.x, cScr.y, arcRadiusPx, -w.angIn, -w.angOut, w.s === -1 ); ctx.stroke(); });  ctx.restore(); });  // 6. 繪製惰輪至兩皮帶輪的尺寸連心虛線 (針對當前選中的惰輪) if (idlers.length > 0) { const actIdl = idlers[Math.min(activeIdlerIndex, idlers.length - 1)]; const idlScr = worldToScreen(actIdl.x, actIdl.y);  ctx.save(); ctx.setLineDash([3, 4]); ctx.lineWidth = 1.2;  // 連至輸入輪 ctx.strokeStyle = '#38bdf8'; ctx.beginPath(); ctx.moveTo(pInScr.x, pInScr.y); ctx.lineTo(idlScr.x, idlScr.y); ctx.stroke();  // 連至輸出輪 ctx.strokeStyle = '#c084fc'; ctx.beginPath(); ctx.moveTo(pOutScr.x, pOutScr.y); ctx.lineTo(idlScr.x, idlScr.y); ctx.stroke();  ctx.restore(); } } }  /************************************************************** * 7. 滑鼠與觸控拖曳互動事件 (支援直接拖曳惰輪與平移縮放) **************************************************************/ let isSpacePressed = false; window.addEventListener('keydown', e => { if (e.code === 'Space') isSpacePressed = true; }); window.addEventListener('keyup', e => { if (e.code === 'Space') isSpacePressed = false; });  canvas.addEventListener('mousedown', e => { const rect = canvas.getBoundingClientRect(); const sx = e.clientX - rect.left; const sy = e.clientY - rect.top; const wpt = screenToWorld(sx, sy);  // 右鍵、中鍵或按住空白鍵：平移畫布 if (e.button === 1 \vert{}\vert{} e.button === 2 \vert{}\vert{} isSpacePressed) { view.isPanning = true; view.panStartX = sx - view.offsetX; view.panStartY = sy - view.offsetY; return; }  // 檢查是否點擊到任一顆惰輪 for (let i = idlers.length - 1; i >= 0; i--) { const idl = idlers[i]; const dist = Math.hypot(wpt.x - idl.x, wpt.y - idl.y); const hitRadius = Math.max(idl.od / 2 + 4, 14 / view.scale); if (dist <= hitRadius) { view.isDraggingIdler = true; view.draggingIdx = i; activeIdlerIndex = i; renderIdlerControls(); drawCanvas(); return; } }  // 若沒點到惰輪，左鍵拖曳空白處也可平移畫布 view.isPanning = true; view.panStartX = sx - view.offsetX; view.panStartY = sy - view.offsetY; });  window.addEventListener('mousemove', e => { const rect = canvas.getBoundingClientRect(); const sx = e.clientX - rect.left; const sy = e.clientY - rect.top; const wpt = screenToWorld(sx, sy);  if (sx >= 0 && sy >= 0 && sx <= rect.width && sy <= rect.height) { document.getElementById('cursorCoordReadout').textContent = `游標座標: X: ${wpt.x.toFixed(1)}, Y: ${wpt.y.toFixed(1)} mm`; }  if (view.isDraggingIdler && view.draggingIdx >= 0) { const idx = view.draggingIdx; let newX = wpt.x; let newY = wpt.y;  // 若在模式一且開啟「自動吸附張緊軌跡」 if (currentMode === 1 && document.getElementById('snapToTension').checked) { const targetL = parseFloat(document.getElementById('targetBeltLength').value) \vert{}\vert{} 450; const projected = projectIdlerToTargetLength(idx, newX, newY, targetL); newX = projected.x; newY = projected.y; }  idlers[idx].x = Number(newX.toFixed(2)); idlers[idx].y = Number(newY.toFixed(2)); updateIdlerReadoutDOM(idx); updateCalculationAndRender(); } else if (view.isPanning) { view.offsetX = sx - view.panStartX; view.offsetY = sy - view.panStartY; drawCanvas(); } });  window.addEventListener('mouseup', () => { view.isDraggingIdler = false; view.draggingIdx = -1; view.isPanning = false; });  canvas.addEventListener('contextmenu', e => e.preventDefault());  canvas.addEventListener('wheel', e => { e.preventDefault(); const rect = canvas.getBoundingClientRect(); const sx = e.clientX - rect.left; const sy = e.clientY - rect.top; const beforeZoomWorld = screenToWorld(sx, sy);  const zoomFactor = e.deltaY < 0 ? 1.12 : 0.89; view.scale = Math.max(0.4, Math.min(12, view.scale * zoomFactor));  view.offsetX = sx - beforeZoomWorld.x * view.scale; view.offsetY = sy + beforeZoomWorld.y * view.scale; drawCanvas(); }, { passive: false });  /************************************************************** * 8. 預設配置載入與一鍵複製工具 **************************************************************/ function loadDemoPreset() { document.getElementById('inTeeth').value = 18; document.getElementById('outTeeth').value = 36; document.getElementById('pulleyDx').value = 75; document.getElementById('pulleyDy').value = 125; document.getElementById('defaultIdlerOd').value = 22; document.getElementById('idlerCount').value = '2'; document.getElementById('targetBeltLength').value = 450; document.getElementById('targetBeltTeeth').value = 90;  idlers = [ { id: 1, od: 22, x: 32.0, y: 52.0, span: 'upper', wrapType: 'outside' }, { id: 2, od: 22, x: 68.0, y: 26.0, span: 'lower', wrapType: 'inside' } ]; activeIdlerIndex = 0;  if (currentMode === 1 && document.getElementById('snapToTension').checked) { snapActiveIdlerNow(); } renderIdlerControls(); resetView(); updateCalculationAndRender(); }  function copySingleIdler(idx) { const idl = idlers[idx]; const dxOut = parseFloat(document.getElementById('pulleyDx').value) \vert{}\vert{} 0; const dyOut = parseFloat(document.getElementById('pulleyDy').value) \vert{}\vert{} 0; const text = `【惰輪 #${idx + 1} (外徑 ${idl.od}mm)】\n` + `相對輸入輪: X = ${idl.x.toFixed(2)} mm, Y = ${idl.y.toFixed(2)} mm (中心距 ${Math.hypot(idl.x, idl.y).toFixed(2)} mm)\n` +
        `相對輸出輪: X = ${(idl.x - dxOut).toFixed(2)} mm, Y =${(idl.y - dyOut).toFixed(2)} mm (中心距 ${Math.hypot(idl.x - dxOut, idl.y - dyOut).toFixed(2)} mm)`; navigator.clipboard.writeText(text); alert('已複製惰輪座標至剪貼簿！\n\n' + text); }  function copyReport() { if (!latestSolution \vert{}\vert{} !latestSolution.valid) return; const sol = latestSolution; const exactL = sol.totalLength; const dxOut = parseFloat(document.getElementById('pulleyDx').value) \vert{}\vert{} 0; const dyOut = parseFloat(document.getElementById('pulleyDy').value) \vert{}\vert{} 0;  let report = `=== HTD-5M 時規皮帶與惰輪配置報告 ===\n`; report += `輸入皮帶輪: ${sol.pIn.teeth} 齒 (PD = ${(sol.pIn.r * 2).toFixed(2)} mm) @ (0, 0)\n`; report += `輸出皮帶輪: ${sol.pOut.teeth} 齒 (PD = ${(sol.pOut.r * 2).toFixed(2)} mm) @ (X=${dxOut}, Y=${dyOut} mm)\n`; report += `實際計算皮帶長: ${exactL.toFixed(2)} mm (${(exactL / 5).toFixed(2)} 齒)\n`; report += `最接近大整數皮帶長: ${Math.floor(exactL) + 1} mm | 最接近小整數皮帶長: ${Math.ceil(exactL) - 1} mm\n`; report += `標準 HTD-5M 規格上限: ${Math.ceil(exactL / 5)} 齒 (${Math.ceil(exactL / 5) * 5} mm) \vert{} 下限: ${Math.floor(exactL / 5)} 齒 (${Math.floor(exactL / 5) * 5} mm)\n\n`;  idlers.forEach((idl, i) => { report += `[惰輪 #${i + 1}] 外徑=${idl.od}mm (${idl.wrapType === 'outside' ? '外壓' : '內撐'})\n`;
        report += `  - 相對輸入輪: ΔX = ${idl.x.toFixed(2)} mm, ΔY =${idl.y.toFixed(2)} mm\n`;
        report += `  - 相對輸出輪: ΔX = ${(idl.x - dxOut).toFixed(2)} mm, ΔY =${(idl.y - dyOut).toFixed(2)} mm\n`;
      });

      navigator.clipboard.writeText(report);
      alert('已複製完整設計參數報告至剪貼簿！');
    }

    // 初始化啟動
    window.addEventListener('resize', resizeCanvas);
    window.addEventListener('DOMContentLoaded', () => {
      renderIdlerControls();
      resizeCanvas();
      if (currentMode === 1 && document.getElementById('snapToTension').checked) {
        snapActiveIdlerNow();
      } else {
        updateCalculationAndRender();
      }
    });
